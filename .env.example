# Used by hosting (e.g. Vercel build settings). Locally, copy
# config/dart_defines.example.json to config/dart_defines.local.json instead.
# Only the public project URL and publishable (anon) key belong in the frontend.
# NEVER put the service_role / secret key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
